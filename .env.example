# Chạy python scripts/setup.py để sinh khóa ngẫu nhiên vào .env.
CAREGIVER_TOKEN=CHANGE_ME
PHONE_TOKEN=CHANGE_ME
TEST_TOKEN=CHANGE_ME
CHEST_TOKEN=CHANGE_ME
CANE_TOKEN=CHANGE_ME
# Tùy chọn: nút tìm gậy cầm tay ESP32-C3 (firmware/find_remote). Để trống để tắt role này.
REMOTE_TOKEN=CHANGE_ME
# test : 1 ESP32 + camera điện thoại
# duo  : 1 ESP32 (firmware/test_one) + 1 ESP32-CAM chỉ chụp (firmware/camera)  <- cấu hình breadboard
# final: ESP32-CAM ngực (firmware/chest_cam) + ESP32 ở gậy (firmware/cane)
PROJECT_MODE=duo
DATA_DIR=data
RETENTION_DAYS=7
# Để trống khi web và API cùng tên miền. Khi dùng frontend ở nơi khác, điền origin chính xác.
ALLOWED_ORIGINS=

# AI: none | segformer | gemini. Không bao giờ trả kết quả AI giả khi chưa cấu hình.
AI_PROVIDER=segformer
# SegFormer-B0 ADE20K có sẵn trong dự án (giống bản nvidia/segformer-b0-finetuned-ade-512-512).
# Đường dẫn tương đối tính từ thư mục gốc dự án. Cần: pip install -r ai/requirements-ai.txt
AI_MODEL_DIR=ai/model-baseline
# gemini: khóa chỉ đặt trên MÁY CHỦ, không bao giờ gửi cho web hay ESP32.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 1 = đèn/còi báo cho người đeo khi ảnh mới nhất (<20 s) có thể là lòng đường/mặt nước. Mặc định tắt.
WEARER_AI_ALERT=0

# Tin nhắn cho người nhà: hiện trong trang “Tin nhắn” của web và được đẩy (Web Push) tới
# điện thoại/máy tính đã bật thông báo. Khóa ký tự sinh trong DATA_DIR/vapid_private.pem.
# Email liên hệ gửi kèm cho dịch vụ push của trình duyệt (nên đổi thành email của nhóm).
VAPID_SUBJECT=mailto:admin@example.com
